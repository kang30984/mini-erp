<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.kang30984.minierp.master.partner.PartnerMapper">

    <resultMap id="partner" type="io.github.kang30984.minierp.master.partner.PartnerResponse">
        <constructor>
            <idArg column="id"         javaType="java.lang.Long"/>
            <arg   column="code"       javaType="java.lang.String"/>
            <arg   column="name"       javaType="java.lang.String"/>
            <arg   column="grade_code" javaType="java.lang.String"/>
            <arg   column="grade_name" javaType="java.lang.String"/>
            <arg   column="status"     javaType="java.lang.String"/>
            <arg   column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="select">
        SELECT p.id, p.code, p.name, p.grade_code, g.name AS grade_name, p.status, p.updated_at
          FROM partner p
          JOIN partner_grade g ON g.grade_code = p.grade_code
    </sql>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null">
                AND (p.name ILIKE #{keyword} OR p.code ILIKE #{keyword})
            </if>
            <if test="gradeCode != null">
                AND p.grade_code = #{gradeCode}
            </if>
            <if test="status != null">
                AND p.status = #{status}
            </if>
        </where>
    </sql>

    <select id="count" resultType="long">
        SELECT count(*) FROM partner p
        <include refid="searchCondition"/>
    </select>

    <select id="search" resultMap="partner">
        <include refid="select"/>
        <include refid="searchCondition"/>
         ORDER BY p.code
         LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findById" resultMap="partner">
        <include refid="select"/>
         WHERE p.id = #{id}
    </select>

    <select id="findByCode" resultMap="partner">
        <include refid="select"/>
         WHERE p.code = #{code}
    </select>

    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM partner WHERE code = #{code})
    </select>

    <insert id="insert">
        INSERT INTO partner (code, name, grade_code, status)
        VALUES (#{code}, #{name}, #{gradeCode}, #{status})
    </insert>

    <update id="update">
        UPDATE partner
           SET name       = #{name},
               grade_code = #{gradeCode},
               status     = #{status},
               updated_at = now()
         WHERE id = #{id}
    </update>
</mapper>
