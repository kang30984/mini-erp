<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.kang30984.minierp.master.product.ProductMapper">

    <resultMap id="product" type="io.github.kang30984.minierp.master.product.ProductResponse">
        <constructor>
            <idArg column="id"         javaType="java.lang.Long"/>
            <arg   column="sku"        javaType="java.lang.String"/>
            <arg   column="name"       javaType="java.lang.String"/>
            <arg   column="category"   javaType="java.lang.String"/>
            <arg   column="unit_price" javaType="java.math.BigDecimal"/>
            <arg   column="stock_qty"  javaType="java.lang.Integer"/>
            <arg   column="status"     javaType="java.lang.String"/>
            <arg   column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, sku, name, category, unit_price, stock_qty, status, updated_at
    </sql>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null">
                AND (name ILIKE #{keyword} OR sku ILIKE #{keyword})
            </if>
            <if test="category != null">
                AND category = #{category}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="count" resultType="long">
        SELECT count(*) FROM product
        <include refid="searchCondition"/>
    </select>

    <select id="search" resultMap="product">
        SELECT <include refid="columns"/>
          FROM product
        <include refid="searchCondition"/>
         ORDER BY category, name, id
         LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findById" resultMap="product">
        SELECT <include refid="columns"/> FROM product WHERE id = #{id}
    </select>

    <select id="findBySku" resultMap="product">
        SELECT <include refid="columns"/> FROM product WHERE sku = #{sku}
    </select>

    <select id="findByIds" resultMap="product">
        SELECT <include refid="columns"/>
          FROM product
         WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="existsBySku" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM product WHERE sku = #{sku})
    </select>

    <insert id="insert">
        INSERT INTO product (sku, name, category, unit_price, stock_qty, status)
        VALUES (#{sku}, #{name}, #{category}, #{unitPrice}, #{stockQty}, #{status})
    </insert>

    <update id="update">
        UPDATE product
           SET name       = #{name},
               category   = #{category},
               unit_price = #{unitPrice},
               stock_qty  = #{stockQty},
               status     = #{status},
               updated_at = now()
         WHERE id = #{id}
    </update>
</mapper>
